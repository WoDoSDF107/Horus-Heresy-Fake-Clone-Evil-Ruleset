    <selectionEntry name="Riji" id="cb1f-e3a9-7b03-4afa" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Command" id="3932-4147-2399-c54c" hidden="false" primary="true" targetId="6dbf-654a-f06f-2d69"/>
      </categoryLinks>
      <infoLinks>
        <infoLink name="Bitter Duty" id="aae6-aa71-637c-d08f" hidden="false" targetId="5d6f-552a-f409-cad5" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Decisive Assassination" id="6b80-2d43-ca85-6c22" hidden="false" typeId="9b5f-da4e-5739-cbcf" typeName="Gambit:">
          <characteristics>
            <characteristic name="Summary" typeId="98f3-41cf-e3be-2ae7"/>
            <characteristic name="Description" typeId="2d7d-b1d9-dead-605a">This gambit may only be selected in the first Face Off Step of a Challenge, and if the Model it is selected for had a Charge declared for it in Controlling Player&apos;s turn. If this Gambit is selected, Hits inflicted by all attacks made by the Model whilst this Gambit is selected for it have their Damage Characteristic set to ‘2’, and the Controlling Player automatically gains Challenge Advantage for that Face Off Step. However, if the Opposing Player&apos;s model is not Removed as a Casualty in the following Strike Step, then the Controlling Player automatically loses the Challenge, and the Model must declare the Fall Back aftermath option.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Veiled in Shadows" id="7ecb-edd9-e4a2-5a30" hidden="false">
          <description>When a Unit that includes only Models with this Special Rule is the target of a Shooting Attack, all attacks must be made as Snap Shots when the distance between the closest Model in the attacking Unit and the Target Unit is 7&quot; or greater. Additionally, a Model with this Special Rule cannot be targeted by weapons with the Barrage (X) Special Rule unless that Model has direct line of sight on the Model with this Special Rule.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Riji" id="02fa-db1f-d428-e991" hidden="false" import="true" type="model">
          <categoryLinks>
            <categoryLink name="Infantry Model Type" id="c5db-39f5-bfb3-32fd" hidden="false" primary="false" targetId="594d-fa82-13cb-a345"/>
