        <profile name="Speed over Skill" id="f6dc-ef6e-8166-0897" hidden="false" typeId="9b5f-da4e-5739-cbcf" typeName="Gambit:">
          <characteristics>
            <characteristic name="Summary" typeId="98f3-41cf-e3be-2ae7">Marino can use this gambit to gain additional attacks in exchange for going last in a Challenge.</characteristic>
            <characteristic name="Description" typeId="2d7d-b1d9-dead-605a">If this Gambit is selected, the Opposing Player automatically gains Challenge Advantage in the following Focus step, but the Model it is selected for has its Current Attacks Characteristic modified by +3 in the Strike Step.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Gene-Edited Speed" id="b841-581c-47d8-fcb9" hidden="false">
          <description>A model with this Special Rule may still have a Charge declared for it in the Assault Phase of the same Player Turn as it made a Rush move.</description>
        </rule>
